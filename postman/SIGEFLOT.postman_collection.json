{
  "info":{"name":"SIGEFLOT API","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "item":[
    {"name":"Root","request":{"method":"GET","url":"{{base_url}}/"},"event":[{"listen":"test","script":{"exec":["pm.test('200',()=>pm.response.to.have.status(200));"]}}]},
    {"name":"Health","request":{"method":"GET","url":"{{base_url}}/health"},"event":[{"listen":"test","script":{"exec":["pm.test('200',()=>pm.response.to.have.status(200));"]}}]},
    {"name":"Health DB","request":{"method":"GET","url":"{{base_url}}/health/db"},"event":[{"listen":"test","script":{"exec":["pm.test('200',()=>pm.response.to.have.status(200));"]}}]},
    {"name":"Login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"{{email}}\",\"password\":\"{{password}}\"}"},"url":"{{base_url}}/api/v1/auth/login"},"event":[{"listen":"test","script":{"exec":["pm.test('200',()=>pm.response.to.have.status(200));","pm.environment.set('access_token',pm.response.json().access_token);"]}}]},
    {"name":"Me","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{access_token}}"}],"url":"{{base_url}}/api/v1/auth/me"},"event":[{"listen":"test","script":{"exec":["pm.test('200',()=>pm.response.to.have.status(200));"]}}]},
    {"name":"Create vehicle","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{access_token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"placa\":\"pm{{$randomInt}}\",\"marca\":\"Toyota\",\"modelo\":\"Hilux\",\"anio\":2022,\"tipo\":\"CAMIONETA\",\"kilometraje_actual\":100}"},"url":"{{base_url}}/api/v1/vehicles"},"event":[{"listen":"test","script":{"exec":["pm.test('201',()=>pm.response.to.have.status(201));","pm.expect(pm.response.json().placa).to.eql(pm.response.json().placa.toUpperCase());","pm.environment.set('vehicle_id',pm.response.json().id);"]}}]},
    {"name":"List vehicles","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{access_token}}"}],"url":"{{base_url}}/api/v1/vehicles?page=1&page_size=20"},"event":[{"listen":"test","script":{"exec":["pm.test('200',()=>pm.response.to.have.status(200));","['items','total','page','page_size'].forEach(k=>pm.expect(pm.response.json()).to.have.property(k));"]}}]},
    {"name":"Get vehicle","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{access_token}}"}],"url":"{{base_url}}/api/v1/vehicles/{{vehicle_id}}"},"event":[{"listen":"test","script":{"exec":["pm.test('200',()=>pm.response.to.have.status(200));"]}}]},
    {"name":"Update vehicle","request":{"method":"PATCH","header":[{"key":"Authorization","value":"Bearer {{access_token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"kilometraje_actual\":200}"},"url":"{{base_url}}/api/v1/vehicles/{{vehicle_id}}"},"event":[{"listen":"test","script":{"exec":["pm.test('200',()=>pm.response.to.have.status(200));"]}}]},
    {"name":"Reject lower mileage","request":{"method":"PATCH","header":[{"key":"Authorization","value":"Bearer {{access_token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"kilometraje_actual\":10}"},"url":"{{base_url}}/api/v1/vehicles/{{vehicle_id}}"},"event":[{"listen":"test","script":{"exec":["pm.test('422',()=>pm.response.to.have.status(422));"]}}]},
    {"name":"Deactivate vehicle","request":{"method":"DELETE","header":[{"key":"Authorization","value":"Bearer {{access_token}}"}],"url":"{{base_url}}/api/v1/vehicles/{{vehicle_id}}"},"event":[{"listen":"test","script":{"exec":["pm.test('204',()=>pm.response.to.have.status(204));"]}}]},
    {"name":"Verify inactive","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{access_token}}"}],"url":"{{base_url}}/api/v1/vehicles/{{vehicle_id}}"},"event":[{"listen":"test","script":{"exec":["pm.test('inactive',()=>pm.expect(pm.response.json().estado).to.eql('INACTIVO'));"]}}]},
    {"name":"Invalid login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"{{email}}\",\"password\":\"incorrect-password\"}"},"url":"{{base_url}}/api/v1/auth/login"},"event":[{"listen":"test","script":{"exec":["pm.test('401',()=>pm.response.to.have.status(401));"]}}]},
    {"name":"Me without token","request":{"method":"GET","url":"{{base_url}}/api/v1/auth/me"},"event":[{"listen":"test","script":{"exec":["pm.test('401',()=>pm.response.to.have.status(401));"]}}]},
    {"name":"Me invalid token","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer invalid"}],"url":"{{base_url}}/api/v1/auth/me"},"event":[{"listen":"test","script":{"exec":["pm.test('401',()=>pm.response.to.have.status(401));"]}}]},
    {"name":"Vehicle not found","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{access_token}}"}],"url":"{{base_url}}/api/v1/vehicles/999999"},"event":[{"listen":"test","script":{"exec":["pm.test('404',()=>pm.response.to.have.status(404));"]}}]},
    {"name":"Negative mileage","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{access_token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"placa\":\"NEG{{$randomInt}}\",\"marca\":\"Test\",\"modelo\":\"Test\",\"anio\":2022,\"tipo\":\"OTRO\",\"kilometraje_actual\":-1}"},"url":"{{base_url}}/api/v1/vehicles"},"event":[{"listen":"test","script":{"exec":["pm.test('422',()=>pm.response.to.have.status(422));"]}}]}
  ]
}
