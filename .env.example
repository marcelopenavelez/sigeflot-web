APP_ENV=development
# Configure these only in a local ignored .env or in Railway variables.
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DATABASE?charset=utf8mb4
JWT_SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=.data/documentos
STORAGE_BUCKET=
STORAGE_ENDPOINT_URL=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PREFIX=ordenes
STORAGE_MAX_FILE_SIZE_BYTES=10485760
