APP_ENV=development

JWT_SECRET_KEY=<DEV_ONLY_CHANGE_ME>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MYSQL_DATABASE=sigeflot_docker
MYSQL_USER=sigeflot
MYSQL_PASSWORD=<DEV_ONLY_CHANGE_ME>
MYSQL_ROOT_PASSWORD=<DEV_ONLY_CHANGE_ME>

DATABASE_URL=mysql+pymysql://sigeflot:<DEV_PASSWORD>@db:3306/sigeflot_docker?charset=utf8mb4

STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/app/.data/documentos
STORAGE_PREFIX=ordenes
STORAGE_MAX_FILE_SIZE_BYTES=10485760

VITE_API_URL=http://localhost:8000
